{
  "name": "bun-next-oxc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bun --bun next build",
    "dev": "bun --bun next dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preinstall": "bun scripts/check-bun-version.mjs",
    "start": "bun --bun next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
